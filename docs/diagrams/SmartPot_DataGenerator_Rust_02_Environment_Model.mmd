flowchart LR
  subgraph target["Target Environment by Mode"]
    direction TB
    auto["AUTO<br/>species baseline curve<br/>day & night circadian cycle"]
    manual["MANUAL<br/>user-defined targets"]
    weather["WEATHER<br/>Open-Meteo local weather<br/>solar radiation, humidity, ambient temp"]
  end
  subgraph actuators["Actuator Physics Response"]
    direction TB
    pump["Water Pump: +1.2% soil moisture/sec"]
    fan["Fan: -0.35°C & -1.5% RH/min"]
    uv["UV Light: +900 lux & +0.05°C/min"]
    hum["Humidifier: +2.5% RH/min"]
    ph["pH Doser: -0.12 pH/sec"]
    nut["Nutrient Doser: +70 ppm TDS/sec"]
  end
  place["Crop Placement<br/>indoor: damped weather & no rain<br/>outdoor / shade: direct weather"]
  relax["Physics Relaxation Step<br/>drift toward targets & natural evaporation"]
  noise["Sensor Noise Model<br/>Gaussian jitter within physical bounds"]
  out(["Telemetry Output<br/>temperature · humidity · brightness<br/>ph · tds · soilMoisture · atmosphere"])
  target --> relax
  actuators --> relax
  place --> relax
  relax --> noise
  noise --> out
  classDef leaf fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef water fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef sun fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef core fill:#067A52,stroke:#0B3D2B,color:#FFFFFF
  class target,actuators leaf
  class place,relax,noise water
  class out core
